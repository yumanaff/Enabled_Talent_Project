{
  "manifest_version": 3,
  "name": "Ease",
  "version": "0.24.0",
  "description": "Makes every website easier to use, based on your own accessibility settings.",
  "permissions": [
    "storage",
    "tabs",
    "tabCapture",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ease",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "shared/defaults.js",
        "shared/profiles.js",
        "shared/storage.js",
        "shared/i18n.js",
        "shared/lock.js",
        "shared/time-rules.js",
        "shared/ai.js",
        "content/engine.js",
        "lib/readability/Readability.js",
        "content/modules/text-size.js",
        "content/modules/line-height.js",
        "content/modules/letter-spacing.js",
        "content/modules/font-family.js",
        "content/modules/reading-guide.js",
        "content/modules/read-aloud.js",
        "content/modules/contrast.js",
        "content/modules/monochrome.js",
        "content/modules/highlight-links.js",
        "content/modules/highlight-titles.js",
        "content/modules/big-cursor.js",
        "content/modules/focus-indicator.js",
        "content/modules/skip-to-content.js",
        "content/modules/bigger-targets.js",
        "content/modules/tremor-filter.js",
        "content/modules/hide-images.js",
        "content/modules/pause-animations.js",
        "content/modules/calm-mode.js",
        "content/modules/pressure-remover.js",
        "content/modules/trigger-blur.js",
        "content/modules/form-saver.js",
        "content/modules/sound-alert.js",
        "content/modules/volume-limiter.js",
        "content/modules/safe-links.js",
        "content/modules/scam-guard.js",
        "content/modules/hide-popups.js",
        "content/modules/same-tab.js",
        "content/modules/scroll-buttons.js",
        "content/modules/typing-filter.js",
        "content/modules/icon-labels.js",
        "content/modules/big-tooltips.js",
        "content/modules/resume-reading.js",
        "content/modules/reading-view.js",
        "content/modules/reading-goals.js",
        "content/modules/page-translate.js",
        "content/modules/time-limits.js",
        "content/modules/explain.js",
        "content/modules/show-me-how.js",
        "content/main.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "MAIN",
      "js": [
        "content/translate-bridge.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "locales/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
